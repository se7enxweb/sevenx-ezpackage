        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="26057" ezremote:identifier="full_intro" name="Intro text" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:ezxhtml="http://ibexa.co/xmlns/dxp/docbook/xhtml" xmlns:ezcustom="http://ibexa.co/xmlns/dxp/docbook/custom" version="5.0-variant ezpublish-1.0">
            <default:para>Wir suchen einen kreativen Art Director, der gerne in einem schnelllebigen Umfeld arbeitet und die Herausforderung liebt, herauszufinden, was beim Verbraucher "Klick" macht. Sie werden mit einem designaffinen Team zusammenarbeiten, um ein Gesamtkonzept zu entwickeln.</default:para>
            <default:para>Ziel ist es, Marketing- und Branding-Strategien in innovative und beeindruckende Kampagnen umzusetzen, die das Zielpublikum stimulieren.</default:para>
          </default:section>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="26058" ezremote:identifier="teaser_intro" name="Teaser intro text" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.0-variant ezpublish-1.0"/>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="26059" ezremote:identifier="job_overview" name="Job overview" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:ezxhtml="http://ibexa.co/xmlns/dxp/docbook/xhtml" xmlns:ezcustom="http://ibexa.co/xmlns/dxp/docbook/custom" version="5.0-variant ezpublish-1.0">
            <default:para>Als Art Director sind Sie verantwortlich für die Leitung des Kreativteams und die Entwicklung von Konzepten und Designs, die den Zielen unserer Kunden entsprechen. Außerdem sind Sie für die Überwachung der Produktion aller Materialien verantwortlich, von Print bis Digital. Wenn Sie ein strategischer Denker mit einer Leidenschaft für Fitness und einem ausgeprägten Sinn für Kreativität sind, möchten wir von Ihnen hören!</default:para>
          </default:section>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="26060" ezremote:identifier="requirements" name="Requirements" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:ezxhtml="http://ibexa.co/xmlns/dxp/docbook/xhtml" xmlns:ezcustom="http://ibexa.co/xmlns/dxp/docbook/custom" version="5.0-variant ezpublish-1.0">
            <default:itemizedlist>
              <default:listitem>
                <default:para>Nachgewiesene Berufserfahrung als Art Director</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Praktische Erfahrung in den Bereichen Logodesign, Typografie, Farbe, Web-Layout-Design, Druckproduktion, Bildauswahl und Verpackungsdesign</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Sicherer Umgang mit InDesign, Photoshop, Illustrator oder anderen visuellen Design- und Wire-Framing-Tools</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Nachgewiesene Fähigkeiten im Grafikdesign mit einem soliden Portfolio</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Fähigkeit, Feedback einzuarbeiten und Anweisungen zu geben/aufzunehmen</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Teamplayer mit guten Kommunikations- und Präsentationsfähigkeiten</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Einschlägige Ausbildung oder Schulung</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Berufserfahrung in der Gesundheits- und Fitnessbranche ist ein Plus</default:para>
              </default:listitem>
            </default:itemizedlist>
          </default:section>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="26061" ezremote:identifier="responsibilities" name="Responsibilities" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:ezxhtml="http://ibexa.co/xmlns/dxp/docbook/xhtml" xmlns:ezcustom="http://ibexa.co/xmlns/dxp/docbook/custom" version="5.0-variant ezpublish-1.0">
            <default:itemizedlist>
              <default:listitem>
                <default:para>Entwicklung klarer Ideen und Konzepte in Zusammenarbeit mit dem Copywriter</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Anfertigung von Skizzen, Storyboards und Entwürfen zur Visualisierung von Ideen</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Verstehen von Marketinginitiativen, strategischer Positionierung und Zielgruppen</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Zusammenarbeit mit dem übrigen Kreativteam über verschiedene Medien hinweg die Arbeit vom Konzept bis zur endgültigen Ausführung innerhalb der Fristen zu erledigen</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Verwalten und Delegieren von Aufgaben an andere Designer und Erteilen von Anweisungen</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Präsentation fertiger Ideen vor Kunden/Teammitgliedern</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Sie behalten den Überblick über alle Trends und halten Sie sich an bewährte Verfahren</default:para>
              </default:listitem>
            </default:itemizedlist>
          </default:section>
        </ezobject:attribute>

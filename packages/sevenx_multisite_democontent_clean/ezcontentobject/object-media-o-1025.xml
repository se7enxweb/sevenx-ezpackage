        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="24573" ezremote:identifier="full_intro" name="Intro text" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:ezxhtml="http://ez.no/xmlns/ezpublish/docbook/xhtml" xmlns:ezcustom="http://ez.no/xmlns/ezpublish/docbook/custom" version="5.0-variant ezpublish-1.0">
            <default:para>This delicious beverage will get you off on the right foot and ready to rock the day. Spinach gives the drink lots of vitamins and a bright green color while oranges and berries take center stage for the flavor.</default:para>
          </default:section>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="24574" ezremote:identifier="teaser_intro" name="Teaser intro text" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.0-variant ezpublish-1.0"/>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" xmlns:ezxhtml="http://ez.no/xmlns/ezpublish/docbook/xhtml" xmlns:xlink="http://www.w3.org/1999/xlink" ezremote:id="24575" ezremote:identifier="body" name="Body text" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:ezxhtml="http://ez.no/xmlns/ezpublish/docbook/xhtml" xmlns:ezcustom="http://ez.no/xmlns/ezpublish/docbook/custom" version="5.0-variant ezpublish-1.0">
            <default:title ezxhtml:level="3">INGREDIENTS</default:title>
            <default:itemizedlist>
              <default:listitem>
                <default:para>85g / 3 ounces organic baby spinach</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>709 / 2 large oranges, peeled and quartered</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>365g / 2 medium bananas</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>121g / 1 cup raspberries</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>½ cup crushed ice</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>79ml / ⅓ cup mango juice concentrate</default:para>
              </default:listitem>
            </default:itemizedlist>
            <default:title ezxhtml:level="3">PREPARATION</default:title>
            <default:orderedlist>
              <default:listitem>
                <default:para>Place all ingredients in a large blender or a food processor fitted with a steel blade. Process until smooth.</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Serve in a glass. Drink. Go be awesome.</default:para>
              </default:listitem>
            </default:orderedlist>
            <default:para>
              <default:emphasis>Recipe credit: <default:link xlink:href="ezurl://26" xlink:show="none">Make Better Food</default:link> / <default:link xlink:href="ezurl://19" xlink:show="none">CC BY</default:link></default:emphasis>
            </default:para>
            <default:para>
              <default:emphasis>Photo credit: <default:link xlink:href="ezurl://26" xlink:show="none">Make Better Food</default:link> / <default:link xlink:href="ezurl://19" xlink:show="none">CC BY</default:link></default:emphasis>
            </default:para>
          </default:section>

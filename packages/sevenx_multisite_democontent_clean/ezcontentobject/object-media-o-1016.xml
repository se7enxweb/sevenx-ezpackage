        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="24384" ezremote:identifier="full_intro" name="Intro text" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:ezxhtml="http://ez.no/xmlns/ezpublish/docbook/xhtml" xmlns:ezcustom="http://ez.no/xmlns/ezpublish/docbook/custom" version="5.0-variant ezpublish-1.0">
            <default:para>An amazing French toast recipe. If you don't have almond extract, substitute vanilla extract for an equally fantastic sandwich.</default:para>
          </default:section>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="24385" ezremote:identifier="teaser_intro" name="Teaser intro text" type="ezxmltext">

        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="24196" ezremote:identifier="full_intro" name="Intro text" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:ezxhtml="http://ez.no/xmlns/ezpublish/docbook/xhtml" xmlns:ezcustom="http://ez.no/xmlns/ezpublish/docbook/custom" version="5.0-variant ezpublish-1.0">
            <default:para>This recipe, for which we highly recommend using homemade bread, combines kale, spinach, avocado, and goat cheese together in a delicious grilled cheese.</default:para>
          </default:section>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="24197" ezremote:identifier="teaser_intro" name="Teaser intro text" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.0-variant ezpublish-1.0"/>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" xmlns:ezxhtml="http://ez.no/xmlns/ezpublish/docbook/xhtml" xmlns:xlink="http://www.w3.org/1999/xlink" ezremote:id="24198" ezremote:identifier="body" name="Body text" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:ezxhtml="http://ez.no/xmlns/ezpublish/docbook/xhtml" xmlns:ezcustom="http://ez.no/xmlns/ezpublish/docbook/custom" version="5.0-variant ezpublish-1.0">
            <default:title ezxhtml:level="3">INGREDIENTS</default:title>
            <default:itemizedlist>
              <default:listitem>
                <default:para>2 slices <default:link xlink:href="ezurl://27" xlink:show="none">bread</default:link></default:para>
              </default:listitem>
              <default:listitem>
                <default:para>2 tablespoons <default:link xlink:href="ezurl://28" xlink:show="none">kale pesto</default:link></default:para>
              </default:listitem>
              <default:listitem>
                <default:para>2 slices mozzarella cheese</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>¼ cup baby spinach</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>⅓ avocado, sliced</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>3 tablespoons crumbled goat cheese</default:para>
              </default:listitem>
            </default:itemizedlist>
            <default:title ezxhtml:level="3">PREPARATION</default:title>
            <default:orderedlist>
              <default:listitem>
                <default:para>Preheat a cast iron skillet over medium heat.</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Spread kale pesto on each slice of bread.</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Place a slice of mozzarella (or your other favourite cheese) on each slice of bread.</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Place baby spinach on top of one slice of bread.</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Slice avocado and place on other piece of bread. Top with several clumps of crumbled goat cheese.</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Quickly and carefully put the sandwich together and grill on a cast iron skillet over medium heat until bread is toasted and cheese has melted, about 3 minutes per side. It may be helpful to cover the skillet with the lid of a large pot to help the cheese melt.</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Serve immediately.</default:para>
              </default:listitem>
            </default:orderedlist>
            <default:para>
              <default:emphasis>Recipe credit: <default:link xlink:href="ezurl://26" xlink:show="none">Make Better Food</default:link> / <default:link xlink:href="ezurl://19" xlink:show="none">CC BY</default:link></default:emphasis>
            </default:para>
            <default:para>
              <default:emphasis>
                <default:emphasis>Photo credit: <default:link xlink:href="ezurl://26" xlink:show="none">Make Better Food</default:link> / <default:link xlink:href="ezurl://19" xlink:show="none">CC BY</default:link></default:emphasis>
              </default:emphasis>
            </default:para>
          </default:section>

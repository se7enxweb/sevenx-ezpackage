        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="24468" ezremote:identifier="full_intro" name="Intro text" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:ezxhtml="http://ez.no/xmlns/ezpublish/docbook/xhtml" xmlns:ezcustom="http://ez.no/xmlns/ezpublish/docbook/custom" version="5.0-variant ezpublish-1.0">
            <default:para>This thick, hearty soup is delicious and well worth the extra effort to bake your own loaf of bread to go with it.</default:para>
          </default:section>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="24469" ezremote:identifier="teaser_intro" name="Teaser intro text" type="ezxmltext">

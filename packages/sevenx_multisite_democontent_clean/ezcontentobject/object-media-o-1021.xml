          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:ezxhtml="http://ez.no/xmlns/ezpublish/docbook/xhtml" xmlns:ezcustom="http://ez.no/xmlns/ezpublish/docbook/custom" version="5.0-variant ezpublish-1.0">
            <default:title ezxhtml:level="3">INGREDIENTS</default:title>
            <default:itemizedlist>
              <default:listitem>
                <default:para>71g / ⅔ cup old-fashioned rolled oats</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>136g / ⅔ cup Greek yogurt</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>⅔ cup water</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>1 teaspoon vanilla or almond extract</default:para>
              </default:listitem>
            </default:itemizedlist>
            <default:title ezxhtml:level="3">PREPARATION</default:title>
            <default:orderedlist>
              <default:listitem>
                <default:para>Combine ingredients in a large mason jar (or divide between two mason jars). Cover tightly with lid and shake. Set in fridge overnight to chill.</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Remove from fridge next morning and enjoy!</default:para>
              </default:listitem>
            </default:orderedlist>
            <default:para>
              <default:emphasis>Recipe credit: <default:link xlink:href="ezurl://26" xlink:show="none">Make Better Food</default:link> / <default:link xlink:href="ezurl://19" xlink:show="none">CC BY</default:link></default:emphasis>
            </default:para>
            <default:para>

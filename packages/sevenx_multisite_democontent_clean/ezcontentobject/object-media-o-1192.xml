        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="26029" ezremote:identifier="full_intro" name="Intro text" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:ezxhtml="http://ibexa.co/xmlns/dxp/docbook/xhtml" xmlns:ezcustom="http://ibexa.co/xmlns/dxp/docbook/custom" version="5.0-variant ezpublish-1.0">
            <default:para>Wir suchen einen Brand-Strategen, der uns dabei hilft, den Ruf unserer Kunden auf dem Fitnessmarkt zu verbessern und ein größeres Publikum anzusprechen.</default:para>
            <default:para>Zu den Aufgaben eines Brand-Strategen gehören die Analyse von Verbraucherdaten, die Ausarbeitung von Plänen für unser Kreativteam und die Entwicklung von Richtlinien zur Förderung unserer Kunden über verschiedene Kanäle. Um in dieser Position erfolgreich zu sein, sollten Sie über umfangreiche Erfahrungen im Markenmanagement und ein gutes Verständnis der Fitnessbranche verfügen.</default:para>
            <default:para>Letztendlich werden Sie sicherstellen, dass die Markenbotschaft und der Tonfall über alle Online- und Offline-Kanäle hinweg konsistent sind.</default:para>
          </default:section>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="26030" ezremote:identifier="teaser_intro" name="Teaser intro text" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" version="5.0-variant ezpublish-1.0"/>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="26031" ezremote:identifier="job_overview" name="Job overview" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:ezxhtml="http://ibexa.co/xmlns/dxp/docbook/xhtml" xmlns:ezcustom="http://ibexa.co/xmlns/dxp/docbook/custom" version="5.0-variant ezpublish-1.0">
            <default:itemizedlist>
              <default:listitem>
                <default:para>Entwerfen und Erstellen von sehr ansprechenden fitnessbezogenen Inhalten im Foto-, Gif- und Videoformat</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Veröffentlichen von Beiträgen auf verschiedenen Social-Media-Kanälen</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Förderung von Inhalten in sozialen Netzwerken und Überwachung des Engagements (z.B. Kommentare und Freigaben)</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Recherchieren fitnessbezogener Themen</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Bearbeitung von Audio- und Sounddesign für Projekte</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Möglichkeiten zur Entwicklung origineller Inhalte und Konzepte für Web und Mobile nutzen</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Erstellung von bewegten Grafiken und Animationen mit 2D- und 3D-Anwendungen für Marketing- und Werbezwecke</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Verwaltung des täglichen Umgangs mit allen Social-Media-Kanälen wie LinkedIn, Facebook, Twitter, Pinterest, Instagram, Tiktok und YouTube und Anpassung der Inhalte</default:para>
              </default:listitem>
            </default:itemizedlist>
          </default:section>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="26032" ezremote:identifier="requirements" name="Requirements" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:ezxhtml="http://ibexa.co/xmlns/dxp/docbook/xhtml" xmlns:ezcustom="http://ibexa.co/xmlns/dxp/docbook/custom" version="5.0-variant ezpublish-1.0">
            <default:itemizedlist>
              <default:listitem>
                <default:para>Berufserfahrung als Brand-Stratege oder in einer ähnlichen Funktion im Marketing</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Ein Portfolio von Projekten zur Markenbildung ist von Vorteil</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Ausgezeichnetes Verständnis des gesamten Marketing-Mix</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Erfahrung in der Entwicklung von Marketingstrategien in der Fitnessbranche</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Datengetriebenes Denken</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Kreativität</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Kommunikations- und Schreibfähigkeiten</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>BSc/MSc in Marketing oder einem relevanten Bereich</default:para>
              </default:listitem>
            </default:itemizedlist>
          </default:section>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" xmlns:default="http://docbook.org/ns/docbook" ezremote:id="26033" ezremote:identifier="responsibilities" name="Responsibilities" type="ezxmltext">
          <default:section xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:ezxhtml="http://ibexa.co/xmlns/dxp/docbook/xhtml" xmlns:ezcustom="http://ibexa.co/xmlns/dxp/docbook/custom" version="5.0-variant ezpublish-1.0">
            <default:itemizedlist>
              <default:listitem>
                <default:para>Einholen von Feedback aus dem Vertrieb und Analysieren des Verbraucherverhaltens, um die Positionierung unseres Unternehmens zu definieren</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Ausarbeitung unserer Differenzierungsstrategie</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Erstellung von Richtlinien, die die Stimme des Unternehmens sowohl online als auch offline definieren (einschließlich Terminologie und Slogans)</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Einweisung unseres Kreativteams in die Marketingprojekte, an denen es arbeiten wird (z.B. Ebooks, E-Mail-Kampagnen und Werbebanner)</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Durchführung von Wettbewerbsanalysen, um die Stärken und Schwächen des Kunden zu ermitteln</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Entwerfen von Werbekampagnen für neue Produkte und Märkte</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Bewertung der Leistung unserer Werbekampagnen und Veranstaltungen</default:para>
              </default:listitem>
              <default:listitem>
                <default:para>Analysieren von Markttrends und Erkennen neuer Chancen und Herausforderungen</default:para>
              </default:listitem>
            </default:itemizedlist>
          </default:section>
        </ezobject:attribute>

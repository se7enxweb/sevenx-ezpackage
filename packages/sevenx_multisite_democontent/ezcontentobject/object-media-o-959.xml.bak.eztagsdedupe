<ezremote:object xmlns:ezremote="http://ez.no/ezobject" xmlns:ezobject="http://ez.no/object/" ezremote:id="82" name="Bodyweight Circuit with Running Pyramid Workout" ezremote:section_id="1" ezremote:owner_id="14" ezremote:class_id="43" ezremote:published="Mon, 23 Jul 2018 11:29:22 GMT" ezremote:modified="Thu, 24 Sep 2020 08:25:29 GMT" remote_id="media-o-959" class_remote_id="e6e3ca754beb50d1268c2d27588926cb" ezremote:class_identifier="ng_article" ezremote:always_available="0" initial_language="eng-US">

        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="1137" ezremote:identifier="teaser_image" name="Teaser image" type="ezimage" image-file-key="e97d218e877e87903245bc71177c4b4c" alternative-text=""/>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="1138" ezremote:identifier="full_intro" name="Intro text" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <paragraph>This recipe, for which we highly recommend using homemade bread, combines kale, spinach, avocado, and goat cheese together in a delicious grilled cheese.</paragraph>
          </section>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="1139" ezremote:identifier="teaser_intro" name="Teaser intro text" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <paragraph>This recipe, for which we highly recommend using homemade bread, combines kale, spinach, avocado, and goat cheese together in a delicious grilled cheese.</paragraph>
          </section>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="1140" ezremote:identifier="body" name="Body text" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <section>
              <section>
                <header>INGREDIENTS</header>
                <ul>
                  <li>
                    <paragraph>2 slices <link href="https://www.makebetterfood.com/recipes/american-sandwich-bread/">bread</link></paragraph>
                  </li>
                  <li>
                    <paragraph>2 tablespoons <link href="https://www.makebetterfood.com/recipes/kale-pesto/">kale pesto</link></paragraph>
                  </li>
                  <li>
                    <paragraph>2 slices mozzarella cheese</paragraph>
                  </li>
                  <li>
                    <paragraph>¼ cup baby spinach</paragraph>
                  </li>
                  <li>
                    <paragraph>⅓ avocado, sliced</paragraph>
                  </li>
                  <li>
                    <paragraph>3 tablespoons crumbled goat cheese</paragraph>
                  </li>
                </ul>
                <header>PREPARATION</header>
                <ol>
                  <li>
                    <paragraph>Preheat a cast iron skillet over medium heat.</paragraph>
                  </li>
                  <li>
                    <paragraph>Spread kale pesto on each slice of bread.</paragraph>
                  </li>
                  <li>
                    <paragraph>Place a slice of mozzarella (or your other favourite cheese) on each slice of bread.</paragraph>
                  </li>
                  <li>
                    <paragraph>Place baby spinach on top of one slice of bread.</paragraph>
                  </li>
                  <li>
                    <paragraph>Slice avocado and place on other piece of bread. Top with several clumps of crumbled goat cheese.</paragraph>
                  </li>
                  <li>
                    <paragraph>Quickly and carefully put the sandwich together and grill on a cast iron skillet over medium heat until bread is toasted and cheese has melted, about 3 minutes per side. It may be helpful to cover the skillet with the lid of a large pot to help the cheese melt.</paragraph>
                  </li>
                  <li>
                    <paragraph>Serve immediately.</paragraph>
                  </li>
                </ol>
                <paragraph>
                  <emphasize>Recipe credit: <link href="https://www.makebetterfood.com/">Make Better Food</link> / <link href="https://creativecommons.org/licenses/by/3.0/">CC BY</link></emphasize>
                  <line/>
                  <line/>
                  <emphasize>
                    <emphasize>Photo credit: <link href="https://www.makebetterfood.com/">Make Better Food</link> / <link href="https://creativecommons.org/licenses/by/3.0/">CC BY</link></emphasize>
                  </emphasize>
                  <line/>
                </paragraph>
              </section>
            </section>
          </section>

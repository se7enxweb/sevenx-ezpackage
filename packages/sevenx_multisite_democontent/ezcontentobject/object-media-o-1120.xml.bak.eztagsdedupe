      <ezobject:object-translation language="eng-US" object_name="We Neglect this Factor when Choosing Healthy Food">
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="939" ezremote:identifier="title" name="Title" type="ezstring">
          <text>We Neglect this Factor when Choosing Healthy Food</text>
        </ezobject:attribute>

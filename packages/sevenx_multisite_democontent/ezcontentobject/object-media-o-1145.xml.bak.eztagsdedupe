    <ezobject:version xmlns:ezremote="http://ez.no/ezobject" ezremote:version="1" ezremote:status="1" ezremote:created="Thu, 24 Sep 2020 08:28:28 GMT" ezremote:modified="Thu, 24 Sep 2020 08:28:38 GMT" initial_language="eng-US">
      <ezobject:object-translation language="eng-US" object_name="Running Free: Ditching the GPS and Learning to Obsess Less">
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="732" ezremote:identifier="title" name="Title" type="ezstring">
          <text>Running Free: Ditching the GPS and Learning to Obsess Less</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="733" ezremote:identifier="headline" name="Headline" type="ezstring">
          <text>Running Free: Ditching the GPS and Learning to Obsess Less</text>
        </ezobject:attribute>

        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="1367" ezremote:identifier="image" name="Image" type="ezimage" image-file-key="f85f1f553806758e2f496c9ef605ffc6" alternative-text="Power-up Smoothie"/>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="1368" ezremote:identifier="teaser_image" name="Teaser image" type="ezimage" image-file-key="a88eb72407517de7f8908bccf7b239cc" alternative-text=""/>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="1369" ezremote:identifier="full_intro" name="Intro text" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <paragraph>This delicious beverage will get you off on the right foot and ready to rock the day. Spinach gives the drink lots of vitamins and a bright green color while oranges and berries take center stage for the flavor.</paragraph>
          </section>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="1370" ezremote:identifier="teaser_intro" name="Teaser intro text" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <paragraph>This delicious beverage will get you off on the right foot and ready to rock the day. Spinach gives the drink lots of vitamins and a bright green color while oranges and berries take center stage for the flavor.</paragraph>
          </section>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="1371" ezremote:identifier="body" name="Body text" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <section>
              <section>
                <header>INGREDIENTS</header>
                <ul>
                  <li>
                    <paragraph>85g / 3 ounces organic baby spinach</paragraph>
                  </li>
                  <li>
                    <paragraph>709 / 2 large oranges, peeled and quartered</paragraph>
                  </li>
                  <li>
                    <paragraph>365g / 2 medium bananas</paragraph>
                  </li>
                  <li>
                    <paragraph>121g / 1 cup raspberries</paragraph>
                  </li>
                  <li>
                    <paragraph>½ cup crushed ice</paragraph>
                  </li>
                  <li>
                    <paragraph>79ml / ⅓ cup mango juice concentrate</paragraph>
                  </li>
                </ul>
                <header>PREPARATION</header>
                <ol>
                  <li>
                    <paragraph>Place all ingredients in a large blender or a food processor fitted with a steel blade. Process until smooth.</paragraph>
                  </li>
                  <li>
                    <paragraph>Serve in a glass. Drink. Go be awesome.</paragraph>
                  </li>
                </ol>
                <paragraph>
                  <emphasize>Recipe credit: <link href="https://www.makebetterfood.com/">Make Better Food</link> / <link href="https://creativecommons.org/licenses/by/3.0/">CC BY</link></emphasize>
                  <line/>
                  <line/>
                  <emphasize>Photo credit: <link href="https://www.makebetterfood.com/">Make Better Food</link> / <link href="https://creativecommons.org/licenses/by/3.0/">CC BY</link></emphasize>
                  <line/>
                </paragraph>
              </section>
            </section>
          </section>
        </ezobject:attribute>

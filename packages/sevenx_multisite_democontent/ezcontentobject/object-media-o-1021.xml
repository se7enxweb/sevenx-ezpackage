        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="1287" ezremote:identifier="body" name="Body text" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <section>
              <section>
                <header>INGREDIENTS</header>
                <ul>
                  <li>
                    <paragraph>71g / ⅔ cup old-fashioned rolled oats</paragraph>
                  </li>
                  <li>
                    <paragraph>136g / ⅔ cup Greek yogurt</paragraph>
                  </li>
                  <li>
                    <paragraph>⅔ cup water</paragraph>
                  </li>
                  <li>
                    <paragraph>1 teaspoon vanilla or almond extract</paragraph>
                  </li>
                </ul>
                <header>PREPARATION</header>
                <ol>
                  <li>
                    <paragraph>Combine ingredients in a large mason jar (or divide between two mason jars). Cover tightly with lid and shake. Set in fridge overnight to chill.</paragraph>
                  </li>
                  <li>
                    <paragraph>Remove from fridge next morning and enjoy!</paragraph>
                  </li>
                </ol>
                <paragraph>

      <ezobject:object-translation language="eng-US" object_name="What HIIT is and What HIIT Isn’t">
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="491" ezremote:identifier="title" name="Title" type="ezstring">
          <text>What HIIT is and What HIIT Isn’t</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="492" ezremote:identifier="teaser_title" name="Teaser title" type="ezstring">
          <text>What HIIT is and What HIIT Isn’t</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="493" ezremote:identifier="authors" name="Author" type="ezobjectrelationlist">
          <related-objects>
            <relation-list/>
          </related-objects>

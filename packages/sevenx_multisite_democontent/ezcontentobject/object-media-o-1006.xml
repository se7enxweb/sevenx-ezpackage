        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="1098" ezremote:identifier="body" name="Body text" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <section>
              <section>
                <header>INGREDIENTS</header>
                <ul>
                  <li>
                    <paragraph>10 eggs</paragraph>
                  </li>
                  <li>
                    <paragraph>1/2 cup almond milk (or regular)</paragraph>
                  </li>
                  <li>
                    <paragraph>1/2 cup diced prosciutto (I bought mine precut)</paragraph>
                  </li>
                  <li>
                    <paragraph>1 pint Divine Flavor fresh grape tomatoes</paragraph>
                  </li>
                  <li>
                    <paragraph>1 cup tightly packed chopped kale</paragraph>
                  </li>
                  <li>
                    <paragraph>salt and pepper to taste</paragraph>
                  </li>
                </ul>
                <header>PREPARATION</header>
                <ol>
                  <li>
                    <paragraph>Preheat oven to 325º.</paragraph>
                  </li>
                  <li>
                    <paragraph>Heat a skillet over medium-high heat and add prosciutto. Saute for a few minutes stirring often.</paragraph>
                  </li>
                  <li>
                    <paragraph>Add the kale and tomatoes and cook for another 3-4 minutes or until kale starts to wilt. Remove from heat.</paragraph>
                  </li>
                  <li>
                    <paragraph>Spray the bottom of one muffin tin with cooking spray.</paragraph>
                  </li>
                  <li>
                    <paragraph>Add 2 tbsp or so of the filling into each muffin well.</paragraph>
                  </li>
                  <li>
                    <paragraph>In a medium bowl add 10 eggs and 1/2 cup milk. Add salt and pepper and whisk really well until all eggs are mixed.</paragraph>
                  </li>
                  <li>
                    <paragraph>Carefully pour into each muffin well. Fill about 3/4 full.</paragraph>
                  </li>
                  <li>
                    <paragraph>Bake for 25 minutes or until quiche cups are set. Remove from oven and serve immediately. If using for meal prep, let cool and store in plastic container in fridge for up to three days.</paragraph>
                  </li>
                </ol>
                <paragraph>

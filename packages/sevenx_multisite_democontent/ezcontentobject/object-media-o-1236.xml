        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4860" ezremote:identifier="item_4_title" name="Item 4 title" type="ezstring">
          <text>Ausprobieren</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4861" ezremote:identifier="item_4_description" name="Item 4 description" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <paragraph>Wir sind ständig dabei, Neues zu schaffen, zu entdecken und zu erforschen. Wir ermutigen jeden, neugierig zu sein und Risiken einzugehen, denn wir wissen, dass Lernen nie aufhört.</paragraph>
          </section>

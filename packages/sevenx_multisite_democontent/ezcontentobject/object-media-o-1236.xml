        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="3945" ezremote:identifier="item_2_title" name="Item 2 title" type="ezstring">
          <text>Kindness for Each Other</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="3946" ezremote:identifier="item_2_description" name="Item 2 description" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <section>
              <paragraph>We care about what our colleagues are going through and want to help them grow. That’s why we always show up for each other with thoughtfulness and humility, listen, learn and empathize.</paragraph>
            </section>
          </section>

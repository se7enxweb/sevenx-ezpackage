        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4848" ezremote:identifier="item_1_title" name="Item 1 title" type="ezstring">
          <text>Kollaboration</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4849" ezremote:identifier="item_1_description" name="Item 1 description" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <paragraph>Wir glauben, dass ein Team von Kreativen viel stärker ist als ein Einzelkämpfer, deshalb arbeiten wir nie allein. Wir verlassen uns gegenseitig auf unsere Unterstützung, unsere Ressourcen und unser Fachwissen.</paragraph>
          </section>

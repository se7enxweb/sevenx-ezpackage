        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="3977" ezremote:identifier="item_6_title" name="Item 6 title" type="ezstring">
          <text>Diversity and Inclusion</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="3978" ezremote:identifier="item_6_description" name="Item 6 description" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <section>
              <paragraph>We believe the power of diversity and inclusion makes us stronger and more creative in our work. We're proud to be a team that celebrates all kinds of perspectives and backgrounds, and we're always looking for ways to make our workplace even more inclusive for everyone.</paragraph>
              <paragraph> </paragraph>
            </section>
          </section>

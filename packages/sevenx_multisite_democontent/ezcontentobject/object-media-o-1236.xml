        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4840" ezremote:identifier="eyebrow_title" name="Eyebrow title" type="ezstring">
          <text></text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4841" ezremote:identifier="title" name="Title" type="ezstring">
          <text>Unsere Prinzipien</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4842" ezremote:identifier="description" name="Description" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <paragraph>Das Wohlergehen unserer Mitarbeiter, Kunden und Communities steht für uns an erster Stelle, und wir bemühen uns, einen positiven Einfluss auf die Welt zu nehmen.</paragraph>
          </section>
        </ezobject:attribute>

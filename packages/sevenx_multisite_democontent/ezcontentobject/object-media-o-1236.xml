        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="3961" ezremote:identifier="item_4_title" name="Item 4 title" type="ezstring">
          <text>Experimenting</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="3962" ezremote:identifier="item_4_description" name="Item 4 description" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <section>
              <paragraph>We're constantly creating, discovering, and exploring new things. We encourage everyone to be curious and take risks, because we know that learning never stops.</paragraph>

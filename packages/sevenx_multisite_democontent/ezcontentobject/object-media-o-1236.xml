        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4856" ezremote:identifier="item_3_title" name="Item 3 title" type="ezstring">
          <text>Work-Life-Balance</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4857" ezremote:identifier="item_3_description" name="Item 3 description" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <paragraph>Wir setzen Prioritäten bei unseren gemeinsamen Zielen und achten darauf, dass wir unsere gemeinsame Zeit sinnvoll nutzen. Wir respektieren die Zeit des anderen und denken immer daran, wie wichtig es ist, Pausen zu machen und auch unser Privatleben zu genießen!</paragraph>
          </section>
        </ezobject:attribute>

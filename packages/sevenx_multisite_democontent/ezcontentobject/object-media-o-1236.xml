        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4852" ezremote:identifier="item_2_title" name="Item 2 title" type="ezstring">
          <text>Freundlichkeit im Umgang miteinander</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4853" ezremote:identifier="item_2_description" name="Item 2 description" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <paragraph>Uns liegt am Herzen, was unsere Kollegen durchmachen, und wir wollen ihnen helfen, sich zu entwickeln. Deshalb begegnen wir einander stets mit Nachdenklichkeit und Bescheidenheit, hören zu, lernen und haben Verständnis füreinander.</paragraph>
          </section>
        </ezobject:attribute>

        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4864" ezremote:identifier="item_5_title" name="Item 5 title" type="ezstring">
          <text>Einfluss nehmen</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4865" ezremote:identifier="item_5_description" name="Item 5 description" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <paragraph>Egal wie groß oder klein, unser Ziel ist es immer, durch Marketingkampagnen, die einen Einfluss auf das Leben der Menschen und ihre Gemeinschaft haben, einen sozialen Nutzen zu schaffen.</paragraph>
          </section>

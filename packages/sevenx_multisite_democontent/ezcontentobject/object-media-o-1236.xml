        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="3953" ezremote:identifier="item_3_title" name="Item 3 title" type="ezstring">
          <text>Work-life Balance</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="3954" ezremote:identifier="item_3_description" name="Item 3 description" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <section>
              <paragraph>We care about prioritizing our shared goals to make sure we spend our shared time wisely. We honor each other’s time and always bear in mind how important it is to take breaks and enjoy our personal life, too!</paragraph>
            </section>
          </section>
        </ezobject:attribute>

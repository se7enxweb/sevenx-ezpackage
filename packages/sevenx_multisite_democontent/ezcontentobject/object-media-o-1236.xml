        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="3937" ezremote:identifier="item_1_title" name="Item 1 title" type="ezstring">
          <text>Collaboration</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="3938" ezremote:identifier="item_1_description" name="Item 1 description" type="ezxmltext">

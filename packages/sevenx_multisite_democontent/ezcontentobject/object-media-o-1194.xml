      <ezobject:object-translation language="ger-DE" object_name="Art Director">
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4148" ezremote:identifier="title" name="Title" type="ezstring">
          <text>Art Director</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4149" ezremote:identifier="teaser_title" name="Teaser title" type="ezstring">

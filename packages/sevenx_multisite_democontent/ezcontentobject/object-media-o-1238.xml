        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4608" ezremote:identifier="item_2_title" name="Item 2 title" type="ezstring">
          <text>Die beste Marketingagentur für Fitnessunternehmen</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4609" ezremote:identifier="item_2_description" name="Item 2 description" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <paragraph>Ich arbeite nun schon seit einigen Jahren mit der Bold Agency zusammen und bin von den Ergebnissen überwältigt. Sie waren ein unschätzbarer Partner bei der Umsetzung meiner Geschäftsideen in umsetzbare Dinge, die zu Ergebnissen führen. Sie haben mir geholfen, meinen Ansatz zu verfeinern und der Zeit voraus zu sein. Ich könnte nicht zufriedener mit ihren Dienstleistungen sein.</paragraph>
          </section>
        </ezobject:attribute>

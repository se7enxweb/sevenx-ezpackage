        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4604" ezremote:identifier="item_1_title" name="Item 1 title" type="ezstring">
          <text>Immer auf dem Laufenden über die neuesten Trends</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4605" ezremote:identifier="item_1_description" name="Item 1 description" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <paragraph>Das Team von Bold Agency verfügt über ein tiefes Verständnis der digitalen Landschaft und ist immer auf dem neuesten Stand, was die neuesten Trends und Technologien angeht. Sie sind auch sehr reaktionsschnell und immer bereit, die Extrameile zu gehen, um mir zu helfen, meine Ziele zu erreichen. Ich würde Bold Agency jeder Fitnessmarke wärmstens empfehlen.</paragraph>
          </section>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4637" ezremote:identifier="item_1_person_image" name="Item 1 Person image" type="ezimage" image-file-key="2631b16939b7f5e662eb32d15afe7a3f" alternative-text=""/>

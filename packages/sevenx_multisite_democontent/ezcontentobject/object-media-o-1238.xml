        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4612" ezremote:identifier="item_3_title" name="Item 3 title" type="ezstring">
          <text>Hochqualifiziertes Team im Online-Marketing</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4613" ezremote:identifier="item_3_description" name="Item 3 description" type="ezxmltext">
          <section xmlns:image="http://ez.no/namespaces/ezpublish3/image/" xmlns:custom="http://ez.no/namespaces/ezpublish3/custom/" xmlns:xhtml="http://ez.no/namespaces/ezpublish3/xhtml/">
            <paragraph>Seit wir mit Bold Agency zusammenarbeiten, hat unser Fitnessstudio einen deutlichen Anstieg an Leads und neuen Mitgliedschaften verzeichnet. Wir sind sehr zufrieden mit den bisherigen Ergebnissen und freuen uns darauf, unser Geschäft mit ihrer Hilfe weiter auszubauen.</paragraph>
          </section>
        </ezobject:attribute>

          <text>Erica Miles</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4607" ezremote:identifier="item_1_person_description" name="Item 1 Person description" type="ezstring">
          <text>Business Manager bei Gym'n'Swim Group</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4638" ezremote:identifier="item_2_position" name="Item 2 position" type="sckenhancedselection">

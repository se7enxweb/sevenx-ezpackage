    <ezobject:version xmlns:ezremote="http://ez.no/ezobject" ezremote:version="1" ezremote:status="1" ezremote:created="Thu, 24 Sep 2020 08:26:09 GMT" ezremote:modified="Thu, 24 Sep 2020 08:26:17 GMT" initial_language="eng-US">
      <ezobject:object-translation language="eng-US" object_name="Effective Training Techniques: Isolation vs Compound Movements">
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="749" ezremote:identifier="title" name="Title" type="ezstring">
          <text>Effective Training Techniques: Isolation vs Compound Movements</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="750" ezremote:identifier="teaser_title" name="Teaser title" type="ezstring">
          <text>Effective Training Techniques: Isolation vs Compound Movements</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="751" ezremote:identifier="authors" name="Author" type="ezobjectrelationlist">

<ezremote:object xmlns:ezremote="http://ez.no/ezobject" xmlns:ezobject="http://ez.no/object/" ezremote:id="114" name="Effective Training Techniques: Isolation vs Compound Movements" ezremote:section_id="1" ezremote:owner_id="14" ezremote:class_id="43" ezremote:published="Thu, 23 Aug 2018 22:44:50 GMT" ezremote:modified="Thu, 24 Sep 2020 08:26:17 GMT" remote_id="media-o-1146" class_remote_id="e6e3ca754beb50d1268c2d27588926cb" ezremote:class_identifier="ng_article" ezremote:always_available="0" initial_language="eng-US">

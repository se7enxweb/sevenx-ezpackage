        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4126" ezremote:identifier="application_deadline" name="Application deadline" type="ezdatetime">
          <date_time>Thu, 01 Jan 1970 00:00:00 GMT</date_time>

      <ezobject:object-translation language="ger-DE" object_name="Product Manager">
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4134" ezremote:identifier="title" name="Title" type="ezstring">
          <text>Product Manager</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4135" ezremote:identifier="teaser_title" name="Teaser title" type="ezstring">
          <text></text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4136" ezremote:identifier="image" name="Image" type="ezimage" image-file-key="e4badc95b68918e0192276df6a0d41da" alternative-text=""/>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="4137" ezremote:identifier="teaser_image" name="Meta Data" type="ezimage" alternative-text=""/>

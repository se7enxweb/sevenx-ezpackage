      <ezobject:object-translation language="eng-US" object_name="The BiPolar Learning Curve">
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="411" ezremote:identifier="title" name="Title" type="ezstring">
          <text>The BiPolar Learning Curve</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="412" ezremote:identifier="teaser_title" name="Teaser title" type="ezstring">
          <text>The BiPolar Learning Curve</text>
        </ezobject:attribute>
        <ezobject:attribute xmlns:ezremote="http://ez.no/ezobject" ezremote:id="413" ezremote:identifier="authors" name="Author" type="ezobjectrelationlist">
